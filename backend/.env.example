# Required
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# CORS Configuration
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# Optional — Bellingcat OSINT (tools degrade gracefully without these)
FIRMS_MAP_KEY=        # NASA FIRMS fire hotspots — https://firms.modaps.eosdis.nasa.gov/api/
ACLED_API_KEY=        # Conflict events — https://acleddata.com/register/
ACLED_EMAIL=          # ACLED account email

# Optional — LangSmith tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ==============================================================================
# LLM PROVIDER CONFIGURATION
# ==============================================================================

# Primary LLM Provider: "zai" (Z.AI GLM), "anthropic" (Claude), "zhipu", or "agentrouter"
# Default: zai (Z.AI GLM-5.1 with thinking mode enabled)
LLM_PROVIDER=zai

# Z.AI GLM Configuration (Primary - Z.AI international platform)
# Get your API key from: https://platform.z.ai/
# Models: glm-5.1 (131K context), glm-5 (65K context), glm-4.7, glm-4.6
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-5.1
ZAI_MAX_TOKENS=131072
ZAI_TEMPERATURE=0.7
ZAI_ENABLE_THINKING=true

# Zhipu AI GLM Configuration (Legacy - Same as Z.AI but with JWT-based auth)
# Uses the same models as Z.AI but with id.secret API key format
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.1

# Anthropic Claude Configuration (Fallback)
# Used when LLM_PROVIDER=anthropic or if Z.AI is unavailable
ANTHROPIC_MODEL=claude-opus-4-5

# AgentRouter Configuration (Alternative Claude-compatible provider)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/
AGENTROUTER_MODEL=claude-sonnet-4-5-20250929
