# ==============================================================================
# PAPARAN AI BACKEND - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED API KEYS
# ------------------------------------------------------------------------------

# Anthropic / Claude API Key
ANTHROPIC_API_KEY=sk-ant-xxx

# Tavily Search API Key (for web search and scraping)
TAVILY_API_KEY=tvly-xxx

# Supabase Configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...  # Backend only - never expose to frontend

# Database Connection String (for PGVector)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://postgres:xxx@db.xxx.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# API Configuration
API_PORT=8000
APP_NAME=Paparan AI
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------

# Primary LLM provider: "anthropic" (default) or "zai"
LLM_PROVIDER=anthropic

# Anthropic Claude Settings
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Alternative: z.ai Configuration (OpenAI-compatible)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/v1
ZAI_MODEL=z1-preview

# ------------------------------------------------------------------------------
# EMBEDDINGS CONFIGURATION
# ------------------------------------------------------------------------------

# Embedding model: "voyage-3" or "openai-text-embedding-3-large"
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSION=1536

# ------------------------------------------------------------------------------
# SCRAPING CONFIGURATION
# ------------------------------------------------------------------------------

# Scraping interval (hours)
SCRAPE_INTERVAL_HOURS=24

# Feed cache expiry (hours)
FEED_CACHE_EXPIRY_HOURS=24

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=5

# Maximum results per search
TAVILY_MAX_RESULTS=10

# ------------------------------------------------------------------------------
# TEXT PROCESSING
# ------------------------------------------------------------------------------

# Text splitting configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval configuration
DEFAULT_K_RESULTS=5
SIMILARITY_THRESHOLD=0.85

# ------------------------------------------------------------------------------
# DOCUMENT PROCESSING
# ------------------------------------------------------------------------------

# Maximum file size (MB)
MAX_FILE_SIZE_MB=50

# Maximum extraction length
MAX_EXTRACT_LENGTH=50000

# Supported file extensions
SUPPORTED_FILE_EXTENSIONS=.pdf,.txt,.md,.markdown,.docx,.pptx

# ------------------------------------------------------------------------------
# EXTRACTION AGENT CONFIGURATION
# ------------------------------------------------------------------------------

EXTRACTION_MODEL=claude-opus-4-5
EXTRACTION_MAX_TOKENS=128000
EXTRACTION_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# JOB PROCESSING
# ------------------------------------------------------------------------------

JOB_PROCESSING_TIMEOUT=300
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_SECONDS=5

# ------------------------------------------------------------------------------
# LANGSMITH OBSERVABILITY (OPTIONAL)
# ------------------------------------------------------------------------------

LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=paparan-ai

# ------------------------------------------------------------------------------
# BELLINGCAT / OSINT TOOLS (OPTIONAL)
# ------------------------------------------------------------------------------

# NASA FIRMS fire hotspots API
# https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# ACLED Conflict Events API
# https://acleddata.com/register/
ACLED_API_KEY=
ACLED_EMAIL=

# ------------------------------------------------------------------------------
# TASK QUEUE (OPTIONAL)
# ------------------------------------------------------------------------------

# Redis configuration for Celery
REDIS_URL=redis://localhost:6379/0

# Celery broker
CELERY_BROKER_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# RAILWAY DEPLOYMENT (OPTIONAL)
# ------------------------------------------------------------------------------

# Railway automatically sets PORT
# PORT=8000

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------

# JWT Secret for additional token validation (if needed)
JWT_SECRET=

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# BAPPENAS / SDI CONFIGURATION
# ------------------------------------------------------------------------------

BAPPENAS_API_URL=https://satudata.go.id/api/v1
DATA_GO_ID_URL=https://satudata.go.id
SDI_REFERENCE_URL=https://satudata.go.id/dokumen

# ------------------------------------------------------------------------------
# CONSISTENCY CHECKING
# ------------------------------------------------------------------------------

SIMILARITY_THRESHOLD=0.85
CONSISTENCY_CHECK_BATCH_SIZE=50
