# ============================================================================
# Paparan AI Backend - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control

# ============================================================================
# REQUIRED: Supabase Configuration (Authentication & Database)
# ============================================================================
# Get these from https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Get from https://supabase.com -> Project Settings -> Database
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ============================================================================
# REQUIRED: LLM Provider Configuration (Choose One)
# ============================================================================
# Which LLM provider to use: zai (default), anthropic, agentrouter, or zhipu
LLM_PROVIDER=zai

# Option A: Z.AI (Primary - Recommended)
# Sign up at https://platform.z.ai/
# Models: glm-5.1 (131K context), glm-5 (65K context), glm-4.7, glm-4.6
ZAI_API_KEY=your-zai-api-key
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-5.1
ZAI_MAX_TOKENS=131072
ZAI_TEMPERATURE=0.7
ZAI_ENABLE_THINKING=true

# Option B: Anthropic Claude (Alternative)
# Sign up at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-4-5

# Option C: AgentRouter (Claude-compatible alternative)
# Sign up at https://agentrouter.org/
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/
AGENTROUTER_MODEL=claude-sonnet-4-5-20250929

# Option D: Zhipu AI GLM (Legacy JWT-based auth)
# Uses same models as Z.AI but with id.secret API key format
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.1

# ============================================================================
# REQUIRED: Tavily API (Web Search)
# ============================================================================
# Sign up at https://tavily.com/
# Required for web search and intelligence gathering features
TAVILY_API_KEY=your-tavily-api-key

# ============================================================================
# OPTIONAL: Additional Services (Graceful Degradation)
# ============================================================================
# These features will be disabled if not configured

# NASA FIRMS for fire hotspot data
# Sign up at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# ACLED for conflict event data
# Sign up at https://acleddata.com/register/
ACLED_API_KEY=
ACLED_EMAIL=

# LangSmith for LLM tracing/debugging
# Sign up at https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ============================================================================
# OPTIONAL: CORS Configuration
# ============================================================================
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# ============================================================================
# OPTIONAL: Access Control
# ============================================================================
# Comma-separated list of whitelisted emails (leave empty for open access)
WHITELISTED_EMAILS=
