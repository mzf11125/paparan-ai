# Paparan.ai Backend Environment Variables
# Copy this file to .env and fill in your values

# ==============================================================================
# Required — LLM & API Keys
# ==============================================================================
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# ==============================================================================
# Required — Supabase (Database + Auth + Vector Store)
# ==============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# CORS Configuration
# ==============================================================================
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# ==============================================================================
# Optional — Bellingcat OSINT (tools degrade gracefully without these)
# ==============================================================================
FIRMS_MAP_KEY=        # NASA FIRMS fire hotspots
ACLED_API_KEY=        # Conflict events
ACLED_EMAIL=          # ACLED account email

# ==============================================================================
# Optional — LangSmith tracing
# ==============================================================================
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# Primary: "zai" (Z.AI GLM), "anthropic" (Claude), "zhipu", or "agentrouter"
LLM_PROVIDER=zai

# Z.AI GLM Configuration (Primary)
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZAI_MODEL=glm-5.1
ZAI_MAX_TOKENS=131072
ZAI_TEMPERATURE=0.7
ZAI_ENABLE_THINKING=true

# Zhipu AI GLM Configuration (Legacy)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-5.1

# Anthropic Claude Configuration (Fallback)
ANTHROPIC_MODEL=claude-opus-4-5

# AgentRouter Configuration (Alternative)
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/
AGENTROUTER_MODEL=claude-sonnet-4-5-20250929

# ==============================================================================
# Access Control
# ==============================================================================
# Comma-separated list of authorized user emails (optional)
WHITELISTED_EMAILS=
