# ========================================
# Paparan.ai Environment Variables
# ========================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zhipu AI GLM Configuration
# Get your API key from: https://open.bigmodel.cn/
# Format: id.secret (e.g., de4f84b87cca4f608642661f3413c3d9.pNIkSymt4W3jq0s4)
ZHIPU_API_KEY=

# GLM Model Selection
# Options: glm-4-flash (fast), glm-4-plus (balanced), glm-4-air (lightweight)
GLM_MODEL=glm-4-flash

# Tavily API (Search & Retrieval)
# Get your API key from: https://tavily.com
TAVILY_API_KEY=

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
